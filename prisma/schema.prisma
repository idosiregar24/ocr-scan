// Prisma schema — StrukScan
// Konvensi penamaan & relasi: lihat .claude/rules/database-standards.md dan docs/PRD-StrukScan-SaaS.md §5.2

generator client {
  provider = "prisma-client-js"
}

// Connection URL dikonfigurasi di prisma.config.ts (Prisma 7+), bukan di sini.
datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
  BIZ
}

enum ReceiptStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime? @map("email_verified")
  // Null untuk user yang hanya login lewat OAuth (Google/GitHub) — tidak punya password lokal.
  passwordHash     String?   @map("password_hash")
  image            String?
  plan             Plan      @default(FREE)
  quotaUsed        Int       @default(0) @map("quota_used")
  stripeCustomerId String?   @unique @map("stripe_customer_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  accounts         Account[]
  sessions         Session[]
  receipts         Receipt[]
  categories       Category[]
  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]
  subscription     Subscription?

  @@map("users")
}

model Receipt {
  id            String        @id @default(cuid())
  userId        String        @map("user_id")
  workspaceId   String?       @map("workspace_id")
  storeName     String?       @map("store_name")
  date          DateTime?
  receiptNo     String?       @map("receipt_no")
  cashier       String?
  paymentMethod String?       @map("payment_method")
  // Key object storage (R2/S3), bukan URL publik — akses lewat signed URL (lihat security-standards.md).
  imageKey      String        @map("image_key")
  subtotal      Decimal?      @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal?      @db.Decimal(12, 2)
  status        ReceiptStatus @default(PENDING)
  // Hasil mentah Claude Vision sebelum dipetakan ke ReceiptItem — sumber reprocessing kalau parsing logic berubah.
  ocrRaw        Json?         @map("ocr_raw")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  items     ReceiptItem[]

  @@index([userId])
  @@index([workspaceId])
  @@index([date])
  @@index([status])
  @@map("receipts")
}

model ReceiptItem {
  id         String   @id @default(cuid())
  receiptId  String   @map("receipt_id")
  categoryId String?  @map("category_id")
  name       String
  qty        Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  receipt  Receipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([receiptId])
  @@index([categoryId])
  @@map("receipt_items")
}

model Workspace {
  id          String   @id @default(cuid())
  ownerId     String   @map("owner_id")
  name        String
  plan        Plan     @default(BIZ)
  memberLimit Int      @default(10) @map("member_limit")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner    User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members  WorkspaceMember[]
  receipts Receipt[]

  @@index([ownerId])
  @@map("workspaces")
}

// Pivot user <-> workspace dengan role, bukan tabel role manual (lihat database-standards.md).
model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Category {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  name        String
  color       String?
  icon        String?
  budgetLimit Decimal? @map("budget_limit") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ReceiptItem[]

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

model Subscription {
  id              String    @id @default(cuid())
  userId          String    @unique @map("user_id")
  stripeId        String?   @unique @map("stripe_id")
  stripeStatus    String?   @map("stripe_status")
  stripePrice     String?   @map("stripe_price")
  midtransOrderId String?   @unique @map("midtrans_order_id")
  trialEndsAt     DateTime? @map("trial_ends_at")
  endsAt          DateTime? @map("ends_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// --- NextAuth.js v5 (Auth.js) Prisma Adapter — model wajib, jangan diubah namanya ---

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
