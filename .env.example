# Salin file ini ke .env.local dan isi dengan value asli.
# JANGAN PERNAH commit file .env/.env.local yang berisi credential asli — lihat .claude/rules/security-standards.md

# --- Database (Prisma + PostgreSQL, Neon/Supabase) ---
DATABASE_URL="postgresql://user:password@localhost:5432/strukscan?schema=public"

# --- Auth (NextAuth.js v5) ---
# Generate: `npx auth secret` atau `openssl rand -base64 32`
NEXTAUTH_SECRET="ganti-dengan-random-secret"
NEXTAUTH_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI / OCR Engine (Gemini Vision API) ---
GEMINI_API_KEY=""

# --- File Storage (Cloudflare R2 / AWS S3-compatible) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="strukscan-receipts"
# Dipakai sebagai fallback saat R2 di atas kosong (dev lokal) — folder relatif ke root project.
STORAGE_LOCAL_DIR=".uploads"

# --- Billing ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""

# --- Email transaksional (Resend) ---
RESEND_API_KEY=""

# --- Job queue async OCR (Trigger.dev) ---
TRIGGER_SECRET_KEY=""

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
